#!/usr/bin/env php
<?php
/**
 * PHP-to-Binary: Standalone CLI Compiler Binary
 * Part of PHP-to-Binary by Anton Barinov <https://github.com/Anton-Barinov>
 */

declare(strict_types=1);

// Automatic Zero-Friction Re-spawn with phar.readonly=0
if (ini_get('phar.readonly') === '1') {
    $cmd = [PHP_BINARY, '-d', 'phar.readonly=0', __FILE__];
    foreach (array_slice($_SERVER['argv'], 1) as $arg) {
        $cmd[] = escapeshellarg($arg);
    }
    passthru(implode(' ', $cmd), $code);
    exit($code);
}

// Autoloader
spl_autoload_register(function ($class) {
    $prefix = 'PhpToBinary\\';
    $baseDir = dirname(__DIR__) . '/src/';

    $len = strlen($prefix);
    if (strncmp($prefix, $class, $len) !== 0) {
        return;
    }

    $relativeClass = substr($class, $len);
    $file = $baseDir . str_replace('\\', '/', $relativeClass) . '.php';

    if (file_exists($file)) {
        require_once $file;
    }
});

use PhpToBinary\Compiler\BinaryBuilder;
use PhpToBinary\Doctor;
use PhpToBinary\Runtime\EngineRegistry;

const VERSION = '1.0.0';

function showBanner(): void {
    echo "\033[1;36m";
    echo "  ██████╗ ██╗  ██╗██████╗     ████████╗ ██████╗     ██████╗ ██╗███╗   ██╗ █████╗ ██████╗ ██╗   ██╗\n";
    echo "  ██╔══██╗██║  ██║██╔══██╗    ╚══██╔══╝██╔═══██╗    ██╔══██╗██║████╗  ██║██╔══██╗██╔══██╗╚██╗ ██╔╝\n";
    echo "  ██████╔╝███████║██████╔╝       ██║   ██║   ██║    ██████╔╝██║██╔██╗ ██║███████║██████╔╝ ╚████╔╝ \n";
    echo "  ██╔═══╝ ██╔══██║██╔═══╝        ██║   ██║   ██║    ██╔══██╗██║██║╚██╗██║██╔══██║██╔══██╗  ╚██╔╝  \n";
    echo "  ██║     ██║  ██║██║            ██║   ╚██████╔╝    ██████╔╝██║██║ ╚████║██║  ██║██║  ██║   ██║   \n";
    echo "  ╚═╝     ╚═╝  ╚═╝╚═╝            ╚═╝    ╚═════╝     ╚═════╝ ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   \n";
    echo "\033[0m";
    echo "  \033[1mCompile any PHP script into a Standalone Native Executable Binary\033[0m\n";
    echo "  Version: \033[1;32mv" . VERSION . "\033[0m | Maintainer: \033[1;33mAnton Barinov\033[0m | GitHub: \033[1;34mgithub.com/Anton-Barinov/PHP-to-Binary\033[0m\n\n";
}

function showHelp(): void {
    showBanner();
    echo "\033[1mUSAGE:\033[0m\n";
    echo "  php-to-binary <command> [entrypoint.php] [options]\n\n";
    echo "\033[1mCOMMANDS:\033[0m\n";
    echo "  \033[1;32mbuild\033[0m <file>           Compile PHP script into standalone binary executable\n";
    echo "  \033[1;32mtargets\033[0m                List supported cross-compilation architectures\n";
    echo "  \033[1;32mdoctor\033[0m                 Run diagnostic checks on local build environment\n";
    echo "  \033[1;32mversion\033[0m                Show compiler version\n\n";
    echo "\033[1mOPTIONS:\033[0m\n";
    echo "  -o, --output=<name>    Output binary executable name\n";
    echo "  --standalone           Embed static PHP micro-runtime (no host PHP required)\n";
    echo "  --target=<arch>        Target platform: linux-x86_64, linux-aarch64, macos-arm64, windows-x64\n";
    echo "  --minify               Minify PHP source code (strip comments and whitespace)\n";
    echo "  --include=<dirs>       Comma-separated list of directories to bundle (e.g. src,vendor)\n";
    echo "  --json                 Output result in machine-readable JSON\n";
    echo "  --help                 Show this help screen\n\n";
    echo "\033[1mEXAMPLES:\033[0m\n";
    echo "  php-to-binary build app.php --output=my-tool\n";
    echo "  php-to-binary build console.php --standalone --output=my-cli --minify\n";
    echo "  php-to-binary build main.php --standalone --target=linux-x86_64 -o release/tool-linux\n";
}

$argv = $_SERVER['argv'];
$command = $argv[1] ?? 'help';

if (in_array('--help', $argv, true) || in_array('-h', $argv, true) || $command === 'help') {
    showHelp();
    exit(0);
}

if (in_array('--version', $argv, true) || in_array('-v', $argv, true) || $command === 'version') {
    echo "PHP-to-Binary v" . VERSION . " by Anton Barinov\n";
    exit(0);
}

if ($command === 'targets') {
    showBanner();
    echo "\033[1mSupported Cross-Compilation Target Architectures:\033[0m\n\n";
    foreach (EngineRegistry::getSupportedTargets() as $code => $info) {
        $isHost = ($code === EngineRegistry::detectHostTarget());
        echo "  \033[1;32m•\033[0m \033[1;36m{$code}\033[0m: {$info['name']}" . ($isHost ? " \033[1;33m[Host Architecture]\033[0m" : "") . "\n";
    }
    echo "\n";
    exit(0);
}

if ($command === 'doctor') {
    showBanner();
    echo "\033[1mDiagnostic Build Environment Check:\033[0m\n\n";
    $diag = Doctor::diagnose();
    $allOk = true;
    foreach ($diag as $check) {
        $icon = $check['status'] ? "\033[1;32m✓\033[0m" : "\033[1;31m✗\033[0m";
        echo "  {$icon} {$check['name']}: {$check['detail']}\n";
        if (!$check['status']) $allOk = false;
    }
    echo "\n";
    exit($allOk ? 0 : 1);
}

if ($command === 'build' || $command === 'compile') {
    $entrypoint = $argv[2] ?? null;

    if (!$entrypoint || str_starts_with($entrypoint, '--')) {
        echo "\033[1;31mError: Missing entrypoint script.\033[0m\nUsage: php-to-binary build <entrypoint.php> [options]\n";
        exit(1);
    }

    if (!file_exists($entrypoint)) {
        echo "\033[1;31mError: Entrypoint script '{$entrypoint}' not found.\033[0m\n";
        exit(1);
    }

    // Parse options
    $output = pathinfo($entrypoint, PATHINFO_FILENAME);
    $standalone = in_array('--standalone', $argv, true);
    $minify = in_array('--minify', $argv, true);
    $isJson = in_array('--json', $argv, true);
    $target = 'auto';
    $includes = [];

    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--output=')) {
            $output = substr($arg, 9);
        } elseif (str_starts_with($arg, '-o=')) {
            $output = substr($arg, 4);
        } elseif (str_starts_with($arg, '--target=')) {
            $target = substr($arg, 9);
        } elseif (str_starts_with($arg, '--include=')) {
            $includes = explode(',', substr($arg, 10));
        }
    }

    $builder = new BinaryBuilder($target, $standalone, $minify, $includes);

    try {
        if (!$isJson) {
            showBanner();
            echo "\033[1mPackaging entrypoint:\033[0m {$entrypoint}\n";
            echo "├─ Mode:          " . ($standalone ? "\033[1;32mStandalone (Embedded Runtime)\033[0m" : "\033[1;36mSelf-Executable Phar\033[0m") . "\n";
            echo "├─ Minification:  " . ($minify ? "\033[1;32mEnabled\033[0m" : "Disabled") . "\n";
            echo "└─ Output:        \033[1;33m{$output}\033[0m\n\n";
        }

        $res = $builder->build($entrypoint, $output);

        if ($isJson) {
            echo json_encode($res, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        } else {
            echo "\033[1;32m🎉 Standalone binary compiled successfully!\033[0m\n";
            echo "  Executable:     \033[1m{$res['output_binary']}\033[0m\n";
            echo "  Binary Size:    " . number_format($res['binary_size']) . " bytes (" . round($res['binary_size'] / 1024, 1) . " KB)\n";
            echo "  Target System:  {$res['target_name']}\n";
            echo "  Files Packaged: {$res['files_packaged']}\n";
            echo "  Build Time:     {$res['duration_ms']} ms\n\n";
            echo "\033[1mRun your binary:\033[0m\n";
            echo "  ./{$output}\n\n";
        }
        exit(0);
    } catch (\Throwable $e) {
        if ($isJson) {
            echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
        } else {
            echo "\033[1;31mBuild Failed: " . $e->getMessage() . "\033[0m\n";
        }
        exit(1);
    }
}

showHelp();
exit(0);
