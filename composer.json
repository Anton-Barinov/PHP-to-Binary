  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Anton Barinov",
      "email": "55404783+Anton-Barinov@users.noreply.github.com",
      "homepage": "https://github.com/Anton-Barinov"
    }
  ],
  "keywords": [
    "php",
    "compiler",
    "binary",
    "standalone",
    "cli",
    "executable",
    "cross-compile",
    "micro-php",
    "packager",
    "go-build-for-php"
  ],
  "bin": [
    "bin/php-to-binary"
  ],
  "autoload": {
    "psr-4": {
      "PhpToBinary\\": "src/"
    }
  },
  "require": {
